{
  "name": "slop-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Controlled local coding-agent application",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^10.0.0 || ^12.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "smoke": "node dist/index.js"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.13.6",
    "eslint": "^9.20.0",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.0.7"
  }
}
