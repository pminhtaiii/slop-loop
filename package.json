{
  "name": "slop-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "prepare": "node scripts/agents/install-git-hooks.mjs",
    "build": "tsc",
    "check:dependency-install": "node scripts/ci/check-dependency-install.mjs",
    "check:staged-size": "node scripts/ci/check-staged-file-size.mjs",
    "validate:runtime": "node scripts/ci/check-runtime.mjs",
    "test:contributors": "node scripts/ci/run-contributor-tests.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:runtime": "node scripts/ci/run-runtime-tests.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.2.17",
    "@langchain/langgraph": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
